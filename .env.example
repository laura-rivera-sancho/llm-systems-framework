GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=1.5
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=8
# Optional: set rates from your current provider pricing to estimate per-request cost.
# Leave unset to record token counts without a monetary estimate.
# GEMINI_INPUT_USD_PER_MILLION_TOKENS=
# GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=
